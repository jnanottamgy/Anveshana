---
/** Shared shell for the disclaimer and privacy pages. */
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { firm } from '../data/site';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  lines: string[];
  lead?: string;
  updated?: string;
}

const { title, description, eyebrow, lines, lead, updated } = Astro.props;

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${firm.url}/` },
      { '@type': 'ListItem', position: 2, name: title, item: `${firm.url}${Astro.url.pathname}` },
    ],
  },
];
---

<Base title={title} description={description} schema={schema}>
  <PageHero
    eyebrow={eyebrow}
    lines={lines}
    lead={lead}
    breadcrumbs={[{ label: title }]}
  />

  <section class="legal section on-bone">
    <div class="container container--text legal__body">
      <slot />
      {updated && <p class="legal__updated">Last updated {updated}.</p>}
    </div>
  </section>

  <CTABand />
</Base>

<style>
  .legal { background: var(--bone); color: var(--text-on-bone); }

  .legal__body :global(h2) {
    font-size: var(--fs-h3);
    font-weight: 300;
    color: var(--text-on-bone);
    margin-top: var(--sp-xl);
    margin-bottom: var(--sp-sm);
  }

  .legal__body :global(h2:first-child) { margin-top: 0; }

  .legal__body :global(h3) {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-on-bone);
    margin-top: var(--sp-lg);
    margin-bottom: var(--sp-2xs);
  }

  .legal__body :global(p) {
    line-height: 1.85;
    color: var(--text-on-bone-dim);
    margin-bottom: 1.25em;
  }

  .legal__body :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1.5em;
    padding-left: 1.25rem;
  }

  .legal__body :global(li) {
    position: relative;
    line-height: 1.8;
    color: var(--text-on-bone-dim);
  }

  .legal__body :global(li)::before {
    content: '';
    position: absolute;
    left: -1.25rem;
    top: 0.8em;
    width: 8px;
    height: 1px;
    background: var(--accent);
  }

  .legal__body :global(a) {
    color: var(--text-on-bone);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent);
  }

  .legal__body :global(strong) { color: var(--text-on-bone); font-weight: 600; }

  .legal__updated {
    margin-top: var(--sp-xl);
    padding-top: var(--sp-md);
    border-top: 1px solid var(--rule-on-bone-soft);
    font-size: var(--fs-small);
    color: var(--text-on-bone-faint);
  }
</style>
