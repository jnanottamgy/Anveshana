---
/**
 * WHATSAPP ACTION
 *
 * Every "request a consultation" control on the site. There is
 * no enquiry form and no consultation page — the action opens a
 * WhatsApp conversation with the chambers directly.
 *
 * wa.me handles the platform split on its own: the WhatsApp app
 * on a phone, WhatsApp Web or the desktop app on a computer.
 *
 * The mark is drawn in currentColor rather than WhatsApp green.
 * The glyph is distinctive enough to be recognised instantly,
 * and a stock green badge would be the one cheap-looking element
 * on the page.
 */
import { whatsappUrl } from '../data/site';

interface Props {
  /** Pre-filled opening line. Omit for the default. */
  message?: string;
  label?: string;
  /** solid = champagne button · ghost = outlined · link = underlined text */
  variant?: 'solid' | 'ghost' | 'link';
  size?: 'md' | 'sm';
  block?: boolean;
  magnetic?: boolean;
  class?: string;
}

const {
  message,
  label = 'Request a consultation',
  variant = 'solid',
  size = 'md',
  block = false,
  magnetic = true,
  class: className = '',
} = Astro.props;

const href = message ? whatsappUrl(message) : whatsappUrl();

const base =
  variant === 'link'
    ? 'link-underline'
    : ['btn', variant === 'ghost' && 'btn--ghost', size === 'sm' && 'btn--sm', block && 'btn--block']
        .filter(Boolean)
        .join(' ');
---

<a
  class:list={[base, 'wa', className]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-magnetic={magnetic && variant !== 'link' ? '0.22' : undefined}
>
  <svg class="wa__mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.465 3.488" />
  </svg>
  <span>{label}</span>
  <span class="visually-hidden">(opens WhatsApp)</span>
</a>

<style>
  .wa__mark {
    width: 1.15em;
    height: 1.15em;
    flex: none;
    /* The glyph's optical centre sits slightly high against
       uppercase Jost; nudge it down onto the cap line. */
    transform: translateY(0.5px);
  }

  .link-underline.wa .wa__mark {
    width: 1em;
    height: 1em;
  }
</style>
