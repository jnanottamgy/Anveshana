---
/**
 * CTA BAND
 *
 * Closes every page. Deep obsidian so it separates cleanly from
 * whatever surface precedes it and hands off into the footer.
 */
import SplitText from './SplitText.astro';
import Monogram from './Monogram.astro';
import WhatsAppAction from './WhatsAppAction.astro';
import { firm } from '../data/site';

interface Props {
  eyebrow?: string;
  lines?: string[];
  body?: string;
  /** Pre-filled WhatsApp opening line, for page-specific context. */
  whatsappMessage?: string;
}

const {
  eyebrow = 'Speak to us',
  lines = ['Tell us what', 'has <em class="accent-italic">happened.</em>'],
  body = 'The first conversation costs you nothing but the time it takes. Message the chambers on WhatsApp and we will tell you plainly whether you have a matter worth pursuing, and what it will realistically take.',
  whatsappMessage,
} = Astro.props;
---

<section class="cta on-ink" aria-labelledby="cta-title">
  <Monogram tone="current" class="cta__watermark" />

  <div class="container cta__inner">
    <div class="cta__copy">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <SplitText as="h2" id="cta-title" class="cta__title" lines={lines} />
      <p class="cta__body" data-reveal style="--reveal-delay: 200ms">{body}</p>
    </div>

    <div class="cta__actions" data-reveal style="--reveal-delay: 280ms">
      <WhatsAppAction message={whatsappMessage} class="cta__btn" />

      <dl class="cta__direct">
        <div>
          <dt>Call</dt>
          <dd><a href={`tel:${firm.phoneHref}`}>{firm.phone}</a></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${firm.email}`}>{firm.email}</a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    background: var(--obsidian);
    color: var(--text-on-ink);
    padding-block: var(--section-y);
    overflow: hidden;
    isolation: isolate;
  }

  /* :global — the class is passed into Monogram, so the element
     carries that component's scope id rather than this one's. */
  :global(.cta__watermark) {
    position: absolute;
    left: -8%;
    top: -30%;
    width: min(52vw, 620px);
    height: auto;
    color: var(--text-on-ink);
    opacity: var(--watermark-op-soft);
    z-index: -1;
    pointer-events: none;
  }

  .cta__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-xl);
  }

  @media (min-width: 940px) {
    .cta__inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--sp-3xl);
      align-items: end;
    }
  }

  .cta .eyebrow { margin-bottom: var(--sp-md); }

  /* :global — the class is passed into SplitText. */
  :global(.cta__title) {
    font-size: var(--fs-h2);
    color: var(--text-on-ink-strong);
    margin-bottom: var(--sp-lg);
  }

  .cta__body {
    font-size: var(--fs-lead);
    line-height: 1.62;
    font-weight: 300;
    color: var(--text-on-ink-dim);
    max-width: 48ch;
  }

  .cta__actions {
    display: flex;
    flex-direction: column;
    gap: var(--sp-lg);
    align-items: flex-start;
  }

  .cta__direct {
    display: grid;
    gap: var(--sp-md);
    width: 100%;
    padding-top: var(--sp-md);
    border-top: 1px solid var(--rule-on-ink);
  }

  .cta__direct dt {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }

  .cta__direct dd a {
    font-family: var(--font-sans);
    font-size: 1rem;
    letter-spacing: 0.03em;
    color: var(--text-on-ink);
    transition: color var(--dur) var(--ease);
    /* Long email addresses must not force a horizontal scroll
       on a narrow phone. */
    overflow-wrap: anywhere;
  }

  .cta__direct dd a:hover { color: var(--accent); }

  @media (min-width: 460px) {
    .cta__direct { grid-template-columns: repeat(2, 1fr); }
  }
</style>
