---
/**
 * HOME HERO
 *
 * A depth scene rather than a photograph. Five layers sit at
 * different Z distances inside a real CSS perspective and drift
 * against each other under the pointer — which reads as
 * expensive precisely because the parallax is dimensional
 * rather than a flat 2D offset, and costs a few hundred bytes
 * instead of a WebGL bundle.
 *
 * Reveal delays are offset by --stage-hold so the entrance
 * begins as the entry curtain parts, not behind it.
 */
import Monogram from '../Monogram.astro';
import SplitText from '../SplitText.astro';
import WhatsAppAction from '../WhatsAppAction.astro';
import { firm } from '../../data/site';

const hold = (ms: number) => `--reveal-delay: calc(var(--stage-hold, 0ms) + ${ms}ms)`;
---

<section class="hero on-ink" data-depth-scene aria-labelledby="hero-title">
  <div class="hero__field" aria-hidden="true">
    <span class="hero__glow" data-depth style="--depth: -10"></span>
    <span class="hero__shaft hero__shaft--a" data-depth style="--depth: -6"></span>
    <span class="hero__shaft hero__shaft--b" data-depth style="--depth: -4"></span>
    <span class="hero__watermark" data-depth style="--depth: -16">
      <Monogram tone="current" />
    </span>
    <span class="hero__grid"></span>
    <span class="hero__vignette"></span>
  </div>

  <div class="container hero__inner">
    <div class="hero__content" data-depth style="--depth: 5">
      <p class="eyebrow hero__eyebrow" data-reveal style={hold(0)}>
        Advocates &amp; Consultants &nbsp;·&nbsp; Bengaluru
      </p>

      <SplitText
        as="h1"
        id="hero-title"
        class="display hero__title"
        stagger={120}
        lines={[
          'Every matter',
          'begins with',
          '<em class="accent-italic">inquiry.</em>',
        ]}
      />

      <p class="lead hero__lead" data-reveal style={hold(540)}>
        <strong>Anveshana</strong> — <span lang="sa">अन्वेषण</span>, Sanskrit for
        inquiry — is a litigation-led practice in the heart of Bengaluru.
        We examine the facts before we argue the law.
      </p>

      <div class="hero__actions" data-reveal style={hold(660)}>
        <WhatsAppAction />
        <a class="link-underline" href="/practice-areas/">
          Explore our practice
          <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <div class="hero__foot" data-reveal style={hold(820)}>
    <div class="container hero__foot-inner">
      <dl class="hero__facts">
        <div class="hero__fact">
          <dt>Chambers</dt>
          <dd>Seshadripuram, Bengaluru</dd>
        </div>
        <div class="hero__fact">
          <dt>Direct</dt>
          <dd><a href={`tel:${firm.phoneHref}`}>{firm.phone}</a></dd>
        </div>
        <div class="hero__fact hero__fact--wide">
          <dt>Practice</dt>
          <dd>Criminal · Civil &amp; Property · Company · Employment · Corporate · Cyber</dd>
        </div>
      </dl>

      <span class="scroll-cue" aria-hidden="true">
        <span class="scroll-cue__label">Scroll</span>
        <span class="scroll-cue__line"></span>
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--header-h) + clamp(3rem, 8vh, 6rem));
    padding-bottom: clamp(9rem, 16vh, 12rem);
    background: var(--ink);
    color: var(--text-on-ink);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---- Depth field --------------------------------------- */
  .hero__field {
    position: absolute;
    inset: -8%;
    z-index: -1;
    transform-style: preserve-3d;
  }

  /* Warm light bleeding in from the upper right, as through a
     high window. Sits furthest back, so it drifts least. */
  .hero__glow {
    position: absolute;
    top: -22%;
    right: -12%;
    width: 78%;
    height: 92%;
    background: radial-gradient(
      circle at 60% 40%,
      var(--glow-hero-1) 0%,
      var(--glow-hero-2) 34%,
      transparent 66%
    );
    filter: blur(28px);
  }

  /* Two soft shafts of light crossing the ink. */
  .hero__shaft {
    position: absolute;
    top: -30%;
    height: 160%;
    transform-origin: top center;
    filter: blur(46px);
  }

  .hero__shaft--a {
    left: 46%;
    width: 22%;
    rotate: 14deg;
    background: linear-gradient(
      180deg,
      var(--shaft-a-1),
      var(--shaft-a-2) 58%,
      transparent
    );
  }

  .hero__shaft--b {
    left: 68%;
    width: 13%;
    rotate: 11deg;
    background: linear-gradient(
      180deg,
      var(--shaft-b),
      transparent 62%
    );
  }

  /* The mark, enormous and nearly invisible — a watermark on
     letterhead, not a logo placement. Furthest layer, so it
     drifts most against the type. */
  .hero__watermark {
    position: absolute;
    right: -6%;
    bottom: -18%;
    width: min(62vw, 720px);
    color: var(--text-on-ink);
    opacity: var(--watermark-op);
  }

  /* :global is required — the <svg> is rendered by Monogram, so
     it carries that component's scope id, not this one's, and a
     plainly-scoped descendant selector would never match it. */
  .hero__watermark :global(svg) {
    width: 100%;
    height: auto;
  }

  /* Architectural column grid — the faint order behind
     everything, like ruled paper or a colonnade. */
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      90deg,
      var(--grid-line) 0 1px,
      transparent 1px calc(100% / 12)
    );
    mask-image: linear-gradient(180deg, transparent, #000 22%, #000 68%, transparent);
  }

  .hero__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 120% 80% at 50% 42%,
      transparent 30%,
      var(--vignette) 100%
    );
  }

  /* ---- Content ------------------------------------------- */
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* NB: sized in rem, not ch. A ch value here would resolve
     against this element's own (body) font size rather than the
     display size of the headline inside it. */
  .hero__content { max-width: min(100%, 34rem); }

  .hero__eyebrow {
    margin-bottom: clamp(1.35rem, 3vh, 2.25rem);
    white-space: nowrap;
  }

  .hero__title {
    /* Its own scale rather than --fs-display: three lines at the
       full display size push the calls to action below the fold
       on a 900px-tall viewport. */
    font-size: clamp(2.55rem, 1.1rem + 5vw, 5.9rem);
    color: var(--text-on-ink-strong);
    /* Generous, because the italic "inquiry." ends on a deep
       Cormorant descender that would otherwise sit in the lead. */
    margin-bottom: clamp(1.9rem, 3.5vh, 2.9rem);
  }

  .hero__lead {
    max-width: 52ch;
    color: var(--text-on-ink-dim);
    margin-bottom: clamp(2rem, 4vh, 2.75rem);
  }

  .hero__lead strong {
    color: var(--text-on-ink);
    font-weight: 500;
  }

  .hero__lead [lang='sa'] {
    color: var(--accent);
    font-weight: 400;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-md) var(--sp-lg);
  }

  /* ---- Foot band ----------------------------------------- */
  .hero__foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding-block: var(--sp-md);
    border-top: 1px solid var(--rule-on-ink-soft);
    background: linear-gradient(180deg, transparent, var(--hero-foot-fade));
  }

  .hero__foot-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-lg);
  }

  .hero__facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-sm) var(--sp-xl);
  }

  .hero__fact dt {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .hero__fact dd {
    font-size: var(--fs-small);
    color: var(--text-on-ink-dim);
    line-height: 1.5;
  }

  .hero__fact dd a { transition: color var(--dur) var(--ease); }
  .hero__fact dd a:hover { color: var(--accent); }

  .scroll-cue {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    flex: none;
  }

  .scroll-cue__label {
    font-family: var(--font-sans);
    font-size: 0.56rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-on-ink-faint);
    writing-mode: vertical-rl;
  }

  /* ---- Responsive ---------------------------------------- */
  @media (max-width: 719px) {
    /* Only the first fact survives on a phone; the practice list
       is a wall of text at that width. */
    .hero__fact:nth-child(n + 2) { display: none; }
    .hero__facts { grid-template-columns: 1fr; }

    /* Drop the rule and tighten so the label stays on one line. */
    .hero__eyebrow {
      font-size: 0.63rem;
      letter-spacing: 0.19em;
    }
    .hero__eyebrow::before { display: none; }
  }

  @media (min-width: 720px) {
    .hero__facts { grid-template-columns: repeat(2, auto); }
  }

  @media (min-width: 1040px) {
    .hero__facts { grid-template-columns: repeat(3, auto); }
    .hero__fact--wide dd { max-width: 46ch; }
    .scroll-cue { display: flex; }
  }
</style>
