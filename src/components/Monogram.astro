---
/**
 * ANVESHANA MONOGRAM
 *
 * The "A" mark and its counter dot, traced directly from the
 * firm's supplied logo artwork (contour sampled at full
 * resolution, then reduced to 18 points — visually identical
 * to the original at any size, ~240 bytes of path data).
 *
 * tone:
 *   brand   — the sampled logo gradient (#1092CA → #3AA7DD)
 *   metal   — the surface's accent metal (champagne on ink,
 *              bronze on paper), so it stays legible in both themes
 *   current — inherits currentColor, for one-colour contexts
 *
 * draw: renders as an animated outline that strokes itself in,
 * then fills. Used once, in the entry curtain.
 */
interface Props {
  tone?: 'brand' | 'metal' | 'current';
  size?: string;
  draw?: boolean;
  class?: string;
  title?: string;
}

const {
  tone = 'brand',
  size = '1em',
  draw = false,
  class: className = '',
  title,
} = Astro.props;

// Unique per instance so multiple monograms on one page don't
// collide on gradient ids.
const uid = 'mg-' + Math.random().toString(36).slice(2, 9);

const MARK_PATH =
  'M 598.3 0 L 615.4 6.4 L 629.3 21.4 L 790.6 307.2 L 727.6 308.2 L 460.5 800.2 ' +
  'L 456.7 821.6 L 468.5 840.8 L 492.5 851.5 L 539.5 856.3 L 540.6 864.3 L 0 864.9 ' +
  'L 0 856.3 L 27.8 855.2 L 64.1 840.3 L 106.3 798.1 L 564.1 15 L 594 0 Z';

const DOT = { cx: 846.7, cy: 711.3, r: 153.3 };
---

<svg
  class:list={['monogram', className, draw && 'monogram--draw']}
  viewBox="0 0 1000 866"
  width={size}
  height={size}
  fill="none"
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  {title && <title>{title}</title>}

  {tone === 'brand' && (
    <defs>
      <linearGradient id={`${uid}-a`} x1="0" y1="0" x2="0.35" y2="1">
        <stop offset="0" stop-color="#1092ca" />
        <stop offset="1" stop-color="#3aa7dd" />
      </linearGradient>
      <linearGradient id={`${uid}-d`} x1="0.2" y1="0" x2="0.8" y2="1">
        <stop offset="0" stop-color="#3aa7dd" />
        <stop offset="1" stop-color="#438dcb" />
      </linearGradient>
    </defs>
  )}

  <path
    class="monogram__mark"
    d={MARK_PATH}
    fill={
      tone === 'brand'
        ? `url(#${uid}-a)`
        : tone === 'metal'
          ? 'var(--accent)'
          : 'currentColor'
    }
  />
  <circle
    class="monogram__dot"
    cx={DOT.cx}
    cy={DOT.cy}
    r={DOT.r}
    fill={
      tone === 'brand'
        ? `url(#${uid}-d)`
        : tone === 'metal'
          ? 'var(--accent)'
          : 'currentColor'
    }
  />
</svg>

<style>
  .monogram {
    display: block;
    overflow: visible;
    /* The width/height attributes above are a pre-CSS fallback.
       Without these two lines, a rule that sets only `width`
       (every watermark on the site) leaves height pinned at 1em
       and squashes the mark into a sliver; aspect-ratio is what
       makes `height: auto` resolve from the viewBox rather than
       collapsing to a square. Callers needing an exact box still
       override both. */
    height: auto;
    aspect-ratio: 1000 / 866;
  }

  /* ---- Self-drawing variant (entry curtain only) ---------- */
  /* The outline strokes itself in, then the fill blooms behind
     it. Path length is set generously; the dash offset only has
     to exceed the true length for the effect to read. */
  .monogram--draw .monogram__mark {
    stroke: var(--accent);
    stroke-width: 6;
    stroke-dasharray: 3600;
    stroke-dashoffset: 3600;
    fill-opacity: 0;
    animation:
      mg-stroke 1150ms cubic-bezier(0.16, 1, 0.3, 1) forwards,
      mg-fill 620ms cubic-bezier(0.16, 1, 0.3, 1) 780ms forwards;
  }

  .monogram--draw .monogram__dot {
    transform-origin: 846.7px 711.3px;
    transform: scale(0);
    animation: mg-dot 620ms cubic-bezier(0.16, 1, 0.3, 1) 900ms forwards;
  }

  @keyframes mg-stroke {
    to { stroke-dashoffset: 0; }
  }

  @keyframes mg-fill {
    to { fill-opacity: 1; stroke-opacity: 0; }
  }

  @keyframes mg-dot {
    to { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .monogram--draw .monogram__mark {
      animation: none;
      fill-opacity: 1;
      stroke-opacity: 0;
    }
    .monogram--draw .monogram__dot {
      animation: none;
      transform: scale(1);
    }
  }
</style>
