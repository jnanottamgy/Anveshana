---
/**
 * PERSON CARD
 *
 * The firm has no usable portraits yet — the photograph on the
 * old site is 133×130px. Rather than reach for a stock headshot
 * (which on a law firm's People page is worse than none), the
 * card renders a typographic plate: the advocate's initials set
 * in the display serif over an ink field.
 *
 * Add `photo` to the person record in data/site.ts and the
 * plate is replaced by the portrait with no other change.
 */
import type { Person } from '../data/site';

interface Props {
  person: Person;
  href?: string;
}

const { person, href } = Astro.props;

const initials = person.name
  .split(' ')
  .map((part) => part[0])
  .join('');

const Wrapper = href ? 'a' : 'div';
---

<Wrapper class="person" href={href} data-tilt="4">
  <div class="person__plate">
    {person.photo ? (
      <img
        class="person__photo"
        src={person.photo}
        alt={`${person.honorific} ${person.name}`}
        loading="lazy"
        width="640"
        height="800"
      />
    ) : (
      <>
        <span class="person__initials" aria-hidden="true">{initials}</span>
        <span class="person__plate-glow" aria-hidden="true"></span>
      </>
    )}
  </div>

  <div class="person__body">
    <p class="person__role">{person.role}</p>
    <h3 class="person__name">
      <span class="person__honorific">{person.honorific}</span>
      {person.name}
    </h3>
    <ul class="person__focus">
      {person.focus.map((area) => <li>{area}</li>)}
    </ul>
  </div>
</Wrapper>

<style>
  .person {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .person__plate {
    position: relative;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      linear-gradient(155deg, var(--plate-from), var(--plate-to));
    border: 1px solid var(--plate-rule);
    isolation: isolate;
  }

  .person__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.04);
    transition: filter var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease);
  }

  /* Colour returns on hover — a restrained, very common
     editorial device that makes a grid of portraits feel
     considered rather than catalogued. */
  .person:hover .person__photo {
    filter: grayscale(0) contrast(1);
    transform: scale(1.03);
  }

  .person__initials {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 300;
    letter-spacing: 0.02em;
    color: var(--plate-fg);
    opacity: 0.22;
    transition: opacity var(--dur-slow) var(--ease), color var(--dur-slow) var(--ease);
  }

  .person:hover .person__initials {
    opacity: 0.42;
    color: var(--accent);
  }

  .person__plate-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      circle at 50% 108%,
      var(--plate-glow),
      transparent 62%
    );
  }

  .person__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .person__role {
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }

  .person__name {
    font-size: var(--fs-h4);
    font-weight: 400;
    color: var(--fg, var(--text-on-ink));
    transition: color var(--dur) var(--ease);
  }

  a.person:hover .person__name { color: var(--accent); }

  .person__honorific {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-faint, var(--text-on-ink-faint));
    margin-bottom: 0.3rem;
  }

  .person__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin-top: 0.25rem;
  }

  .person__focus li {
    font-size: var(--fs-micro);
    letter-spacing: 0.04em;
    color: var(--fg-faint, var(--text-on-ink-faint));
  }

  .person__focus li + li::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--accent);
  }
</style>
