---
/**
 * PERSON CARD — the grid item on the home page.
 *
 * The plate itself lives in Portrait.astro, which both this and
 * the People page render, so a portrait looks identical wherever
 * it appears.
 */
import Portrait from './Portrait.astro';
import type { Person } from '../data/site';

interface Props {
  person: Person;
  href?: string;
}

const { person, href } = Astro.props;

const Wrapper = href ? 'a' : 'div';
---

<Wrapper class="person" href={href} data-tilt="4">
  <Portrait person={person} variant="card" />

  <div class="person__body">
    <p class="person__role">{person.role}</p>
    <h3 class="person__name">
      <span class="person__honorific">{person.honorific}</span>
      {person.name}
    </h3>
    <ul class="person__focus">
      {person.focus.map((area) => <li>{area}</li>)}
    </ul>
  </div>
</Wrapper>

<style>
  .person {
    display: flex;
    flex-direction: column;
    gap: var(--sp-md);
  }

  .person__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .person__role {
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }

  .person__name {
    font-size: var(--fs-h4);
    font-weight: 400;
    color: var(--fg, var(--text-on-ink));
    transition: color var(--dur) var(--ease);
  }

  a.person:hover .person__name { color: var(--accent); }

  .person__honorific {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-faint, var(--text-on-ink-faint));
    margin-bottom: 0.3rem;
  }

  .person__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin-top: 0.25rem;
  }

  .person__focus li {
    font-size: var(--fs-micro);
    letter-spacing: 0.04em;
    color: var(--fg-faint, var(--text-on-ink-faint));
  }

  .person__focus li + li::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--accent);
  }
</style>
