---
/**
 * THEME TOGGLE
 *
 * Dark is the brand default. This switches to the light theme
 * and remembers the choice.
 *
 * The knob is a SOLID metal disc that slides under whichever
 * icon is active, and that icon flips to the dark on-metal
 * colour so it reads as printed on the disc. An earlier version
 * used a translucent knob floating over the icons, which at
 * 26px simply read as a smudge — two overlapping shapes at
 * similar values never resolve into one legible control.
 *
 * role="switch" rather than a checkbox: it is a binary on/off
 * control that takes effect immediately. The accessible name
 * stays constant ("Light mode") while aria-checked carries the
 * state — renaming a control as it is pressed is disorienting
 * on a screen reader.
 *
 * The no-flash script lives in Base.astro's <head>; it must run
 * before first paint, which a component script cannot.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle', className]}
  data-theme-toggle
  role="switch"
  aria-checked="false"
  aria-label="Light mode"
>
  <span class="theme-toggle__track" aria-hidden="true">
    <span class="theme-toggle__knob"></span>

    <span class="theme-toggle__slot">
      <!-- Moon -->
      <svg class="theme-toggle__icon" viewBox="0 0 24 24" fill="none">
        <path
          d="M20.2 14.8A8.6 8.6 0 0 1 9.2 3.8a8.6 8.6 0 1 0 11 11Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </svg>
    </span>

    <span class="theme-toggle__slot">
      <!-- Sun -->
      <svg class="theme-toggle__icon" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
        <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M12 3v1.8M12 19.2V21M3 12h1.8M19.2 12H21" />
          <path d="M5.6 5.6 6.9 6.9M17.1 17.1l1.3 1.3M18.4 5.6 17.1 6.9M6.9 17.1 5.6 18.4" />
        </g>
      </svg>
    </span>
  </span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem;
    margin: -0.3rem;
    border-radius: var(--radius-pill);
    flex: none;
  }

  .theme-toggle__track {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    width: 56px;
    height: 28px;
    padding: 3px;
    border: 1px solid var(--rule-on-ink);
    border-radius: var(--radius-pill);
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .theme-toggle:hover .theme-toggle__track,
  .theme-toggle:focus-visible .theme-toggle__track {
    border-color: var(--rule-metal);
  }

  /* The disc. Solid, and behind the icons. */
  .theme-toggle__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent);
    transition: transform var(--dur) var(--ease);
  }

  :global([data-theme='light']) .theme-toggle__knob {
    transform: translateX(28px);
  }

  .theme-toggle__slot {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
  }

  .theme-toggle__icon {
    width: 14px;
    height: 14px;
    /* Inactive: a quiet outline on the track. */
    color: var(--text-on-ink-faint);
    transition: color var(--dur) var(--ease);
  }

  /* Active icon sits on the metal disc, so it takes the dark
     on-metal colour — 8.3:1 against champagne. */
  .theme-toggle__slot:first-of-type .theme-toggle__icon {
    color: var(--on-metal);
  }

  :global([data-theme='light']) .theme-toggle__slot:first-of-type .theme-toggle__icon {
    color: var(--text-on-ink-faint);
  }

  :global([data-theme='light']) .theme-toggle__slot:last-of-type .theme-toggle__icon {
    color: var(--on-metal);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__knob { transition: none; }
  }
</style>
