---
/**
 * THEME TOGGLE
 *
 * Dark is the brand default. This switches to the light theme
 * and remembers the choice.
 *
 * role="switch" rather than a checkbox: it is a binary on/off
 * control that takes effect immediately, which is exactly what
 * the switch role describes. The accessible name stays constant
 * ("Light mode") while aria-checked carries the state — renaming
 * a control as it is pressed is disorienting on a screen reader.
 *
 * The no-flash script lives in Base.astro's <head>; it must run
 * before first paint, which a component script cannot.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle', className]}
  data-theme-toggle
  role="switch"
  aria-checked="false"
  aria-label="Light mode"
>
  <span class="theme-toggle__track" aria-hidden="true">
    <!-- Moon -->
    <svg class="theme-toggle__icon theme-toggle__icon--dark" viewBox="0 0 24 24" fill="none">
      <path
        d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"
      />
    </svg>

    <!-- Sun -->
    <svg class="theme-toggle__icon theme-toggle__icon--light" viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.4" />
      <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2" />
        <path d="M6.3 6.3 4.8 4.8M19.2 19.2l-1.5-1.5M17.7 6.3l1.5-1.5M4.8 19.2l1.5-1.5" />
      </g>
    </svg>

    <span class="theme-toggle__knob"></span>
  </span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem;
    margin: -0.35rem;
    border-radius: var(--radius-pill);
    color: var(--fg-dim, var(--text-on-ink-dim));
    transition: color var(--dur) var(--ease);
  }

  .theme-toggle:hover { color: var(--accent); }

  .theme-toggle__track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 52px;
    height: 26px;
    padding-inline: 5px;
    border: 1px solid var(--rule-on-ink);
    border-radius: var(--radius-pill);
    transition: border-color var(--dur) var(--ease);
  }

  .theme-toggle:hover .theme-toggle__track { border-color: var(--rule-metal); }

  .theme-toggle__icon {
    position: relative;
    z-index: 1;
    width: 13px;
    height: 13px;
    flex: none;
    transition: opacity var(--dur) var(--ease);
  }

  /* The icon for the theme you are IN is bright; the other is
     dimmed. The knob then sits over the active one. */
  .theme-toggle__icon--dark { opacity: 1; }
  .theme-toggle__icon--light { opacity: 0.45; }

  /* :global on the ancestor — without it Astro scopes the
     [data-theme] selector to <html>, which carries no component
     scope id, and the rule silently never matches. */
  :global([data-theme='light']) .theme-toggle__icon--dark { opacity: 0.45; }
  :global([data-theme='light']) .theme-toggle__icon--light { opacity: 1; }

  .theme-toggle__knob {
    position: absolute;
    top: 50%;
    left: 3px;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    border-radius: 50%;
    background: var(--accent);
    /* Low opacity so the icon underneath reads through it — the
       knob marks position without hiding the state. */
    opacity: 0.24;
    transition: transform var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  :global([data-theme='light']) .theme-toggle__knob {
    transform: translateX(24px);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__knob { transition: none; }
  }
</style>
