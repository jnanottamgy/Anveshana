---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Introduction from '../components/home/Introduction.astro';
import PracticeIndex from '../components/PracticeIndex.astro';
import Process from '../components/home/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import PeopleTeaser from '../components/home/PeopleTeaser.astro';
import CTABand from '../components/CTABand.astro';
import { firm, practiceAreas } from '../data/site';

const description =
  'Litigation-led law firm in Bengaluru. Criminal, civil and property, company, corporate, intellectual property, tax, employment and cyber matters.';

/* Lists the firm's services against the organisation entity, so
   a search engine can associate each practice area with it. */
const schema = [
  {
    '@type': 'WebPage',
    '@id': `${firm.url}/#webpage`,
    url: `${firm.url}/`,
    name: `${firm.legalName} — Law Firm in Bengaluru`,
    isPartOf: { '@id': `${firm.url}/#website` },
    about: { '@id': `${firm.url}/#organisation` },
    description,
  },
  ...practiceAreas.map((area) => ({
    '@type': 'Service',
    name: area.title,
    serviceType: area.title,
    description: area.summary,
    url: `${firm.url}/practice-areas/${area.slug}/`,
    provider: { '@id': `${firm.url}/#organisation` },
    areaServed: { '@type': 'City', name: 'Bengaluru' },
  })),
];
---

<Base
  title="Anveshana Advocates & Consultants — Law Firm in Bengaluru"
  description={description}
  suffix={false}
  schema={schema}
>
  <Hero />
  <Introduction />
  <PracticeIndex />
  <Process />
  <Testimonials />
  <PeopleTeaser />
  <CTABand />
</Base>
