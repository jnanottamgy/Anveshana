---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { firm, practiceAreas, formEndpoint } from '../data/site';

const description =
  'Contact Anveshana Advocates & Consultants — Kumarapark East, Crescent Road, Seshadripuram, Bengaluru 560001. Call +91 99641 40121 or request a consultation.';

const schema = [
  {
    '@type': 'ContactPage',
    '@id': `${firm.url}/contact/#webpage`,
    url: `${firm.url}/contact/`,
    name: `Contact — ${firm.legalName}`,
    description,
    about: { '@id': `${firm.url}/#organisation` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${firm.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${firm.url}/contact/` },
    ],
  },
];

const mapSrc = `https://maps.google.com/maps?q=${firm.geo.lat},${firm.geo.lng}&z=16&output=embed`;
---

<Base title="Contact" description={description} schema={schema}>
  <PageHero
    eyebrow="Contact"
    lines={['Tell us what', 'has <em class="accent-italic">happened.</em>']}
    lead="The first conversation costs you nothing but the time it takes. Write to us below, or call the chambers directly."
    breadcrumbs={[{ label: 'Contact' }]}
  />

  <section class="contact section on-bone">
    <div class="container contact__grid">
      <!-- ---- Enquiry form ---- -->
      <div class="contact__form-col">
        <h2 class="eyebrow" data-reveal>Send an enquiry</h2>

        <form
          class="form"
          id="enquiry"
          data-form
          data-endpoint={formEndpoint}
          data-mailto={firm.email}
          novalidate
          data-reveal
          style="--reveal-delay: 90ms"
        >
          <div class="form__row">
            <div class="field">
              <label class="field__label" for="name">Your name</label>
              <input class="field__input" type="text" id="name" name="name"
                     autocomplete="name" required />
              <p class="field__error" data-error-for="name"></p>
            </div>

            <div class="field">
              <label class="field__label" for="phone">Phone</label>
              <input class="field__input" type="tel" id="phone" name="phone"
                     autocomplete="tel" inputmode="tel" required />
              <p class="field__error" data-error-for="phone"></p>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="email">Email</label>
            <input class="field__input" type="email" id="email" name="email"
                   autocomplete="email" required />
            <p class="field__error" data-error-for="email"></p>
          </div>

          <div class="field">
            <label class="field__label" for="matter">Nature of the matter</label>
            <div class="field__select-wrap">
              <select class="field__input field__select" id="matter" name="matter" required>
                <option value="" selected disabled>Please select</option>
                {practiceAreas.map((area) => (
                  <option value={area.title}>{area.title}</option>
                ))}
                <option value="Not sure">I am not sure</option>
              </select>
              <span class="field__chevron" aria-hidden="true"></span>
            </div>
            <p class="field__error" data-error-for="matter"></p>
          </div>

          <div class="field">
            <label class="field__label" for="message">What has happened?</label>
            <textarea class="field__input field__textarea" id="message" name="message"
                      rows="6" required
                      placeholder="A few lines is enough. Please do not include confidential documents at this stage."></textarea>
            <p class="field__error" data-error-for="message"></p>
          </div>

          <!-- Honeypot: invisible to people, irresistible to bots. -->
          <div class="form__trap" aria-hidden="true">
            <label for="company">Company (leave blank)</label>
            <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
          </div>

          <p class="form__notice">
            Sending an enquiry does not create an advocate–client relationship,
            and this form is not a secure channel. Please do not send
            confidential or privileged material until we have spoken.
          </p>

          <button class="btn btn--block form__submit" type="submit">
            <span data-submit-label>Send enquiry</span>
            <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </button>

          <p class="form__status" data-form-status role="status" aria-live="polite"></p>
        </form>
      </div>

      <!-- ---- Details ---- -->
      <aside class="contact__details">
        <div class="detail-block" data-reveal>
          <h2 class="detail-block__label">Chambers</h2>
          <address class="detail-block__value">
            {firm.address.line1}<br />
            {firm.address.line2}<br />
            {firm.address.city} {firm.address.postalCode}
          </address>
          <a class="link-underline" href={firm.mapsDirections} target="_blank" rel="noopener noreferrer">
            Get directions
            <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="detail-block" data-reveal style="--reveal-delay: 80ms">
          <h2 class="detail-block__label">Direct</h2>
          <a class="detail-block__strong" href={`tel:${firm.phoneHref}`}>{firm.phone}</a>
          <a class="detail-block__strong" href={`mailto:${firm.email}`}>{firm.email}</a>
        </div>

        <div class="detail-block" data-reveal style="--reveal-delay: 160ms">
          <h2 class="detail-block__label">Consultation hours</h2>
          <dl class="hours">
            {firm.hours.map((slot) => (
              <div class="hours__row">
                <dt>{slot.days}</dt>
                <dd>{slot.time}</dd>
              </div>
            ))}
          </dl>
        </div>

        <!-- Click-to-load map: no third-party request, and no
             250 KB iframe, until the visitor asks for one. -->
        <div class="map" data-map data-src={mapSrc} data-reveal style="--reveal-delay: 240ms">
          <button class="map__trigger" type="button" data-map-load>
            <span class="map__pin" aria-hidden="true"></span>
            <span class="map__label">Load map</span>
            <span class="map__note">Loads Google Maps in this page</span>
          </button>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  /* ---- Enquiry form -------------------------------------- */
  const form = document.querySelector<HTMLFormElement>('[data-form]');

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submit = form.querySelector<HTMLButtonElement>('.form__submit');
    const label = form.querySelector<HTMLElement>('[data-submit-label]');
    const endpoint = form.dataset.endpoint || '';
    const mailto = form.dataset.mailto || '';

    const RULES: Record<string, (v: string) => string> = {
      name: (v) => (v.trim().length < 2 ? 'Please tell us your name.' : ''),
      phone: (v) =>
        /^[\d\s+()-]{8,20}$/.test(v.trim()) ? '' : 'Please enter a phone number we can reach you on.',
      email: (v) =>
        /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) ? '' : 'Please enter a valid email address.',
      matter: (v) => (v ? '' : 'Please choose the nature of the matter.'),
      message: (v) =>
        v.trim().length < 20 ? 'Please give us a little more detail — a few lines is enough.' : '',
    };

    const showError = (name: string, msg: string) => {
      const field = form.querySelector<HTMLElement>(`[name="${name}"]`);
      const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (slot) slot.textContent = msg;
      if (field) {
        field.classList.toggle('is-invalid', Boolean(msg));
        field.setAttribute('aria-invalid', msg ? 'true' : 'false');
      }
    };

    const validate = () => {
      let firstBad: string | null = null;
      for (const [name, rule] of Object.entries(RULES)) {
        const el = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
        const msg = rule(el?.value ?? '');
        showError(name, msg);
        if (msg && !firstBad) firstBad = name;
      }
      return firstBad;
    };

    /* Clear a field's error as soon as it becomes valid, rather
       than making the visitor resubmit to find out. */
    Object.keys(RULES).forEach((name) => {
      form.querySelector(`[name="${name}"]`)?.addEventListener('input', (e) => {
        const el = e.target as HTMLInputElement;
        if (el.classList.contains('is-invalid') && !RULES[name](el.value)) showError(name, '');
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status || !submit || !label) return;

      const bad = validate();
      if (bad) {
        status.textContent = 'Please check the highlighted fields.';
        status.className = 'form__status is-error';
        form.querySelector<HTMLElement>(`[name="${bad}"]`)?.focus();
        return;
      }

      const data = new FormData(form);
      /* Honeypot tripped — pretend success and drop it. */
      if (data.get('company')) {
        status.textContent = 'Thank you. We will be in touch shortly.';
        status.className = 'form__status is-ok';
        form.reset();
        return;
      }

      const payload = Object.fromEntries(data.entries());
      delete (payload as Record<string, unknown>).company;

      if (!endpoint) {
        /* No handler configured yet. Rather than lose the
           enquiry, hand it to the visitor's mail client fully
           composed. See HANDOFF.md to wire up a real endpoint. */
        const body = [
          `Name: ${payload.name}`,
          `Phone: ${payload.phone}`,
          `Email: ${payload.email}`,
          `Nature of matter: ${payload.matter}`,
          '',
          String(payload.message),
        ].join('\n');
        window.location.href =
          `mailto:${mailto}?subject=${encodeURIComponent(`Website enquiry — ${payload.matter}`)}` +
          `&body=${encodeURIComponent(body)}`;
        status.textContent = 'Opening your email app to send this enquiry…';
        status.className = 'form__status is-ok';
        return;
      }

      submit.disabled = true;
      label.textContent = 'Sending…';
      status.textContent = '';
      status.className = 'form__status';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent =
          'Thank you. Your enquiry has reached the chambers and we will respond shortly.';
        status.className = 'form__status is-ok';
      } catch {
        status.innerHTML =
          `We could not send that just now. Please call <a href="tel:${'+919964140121'}">+91 99641 40121</a> ` +
          `or email <a href="mailto:${mailto}">${mailto}</a>.`;
        status.className = 'form__status is-error';
      } finally {
        submit.disabled = false;
        label.textContent = 'Send enquiry';
      }
    });
  }

  /* ---- Click-to-load map --------------------------------- */
  const map = document.querySelector<HTMLElement>('[data-map]');
  map?.querySelector('[data-map-load]')?.addEventListener('click', () => {
    const frame = document.createElement('iframe');
    frame.src = map.dataset.src || '';
    frame.title = 'Map showing the location of Anveshana Advocates & Consultants';
    frame.loading = 'lazy';
    frame.referrerPolicy = 'no-referrer-when-downgrade';
    frame.className = 'map__frame';
    map.replaceChildren(frame);
  });
</script>

<style>
  .contact { background: var(--bone); color: var(--text-on-bone); }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-2xl);
  }

  @media (min-width: 980px) {
    .contact__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--sp-3xl);
      align-items: start;
    }
  }

  .contact .eyebrow { margin-bottom: var(--sp-lg); }

  /* ---- Form ---------------------------------------------- */
  .form { display: flex; flex-direction: column; gap: var(--sp-md); }

  .form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-md);
  }

  @media (min-width: 560px) {
    .form__row { grid-template-columns: repeat(2, 1fr); }
  }

  .field { display: flex; flex-direction: column; gap: 0.45rem; }

  .field__label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-on-bone-dim);
  }

  /* Underline-only inputs: a boxed form would fight the
     hairline language used everywhere else on the site. */
  .field__input {
    width: 100%;
    padding: 0.85rem 0.1rem;
    font-size: 1rem;
    color: var(--text-on-bone);
    background: transparent;
    border-bottom: 1px solid var(--rule-on-bone);
    border-radius: 0;
    transition: border-color var(--dur) var(--ease);
  }

  .field__input::placeholder { color: var(--text-on-bone-faint); }

  .field__input:hover { border-bottom-color: var(--text-on-bone-faint); }

  .field__input:focus {
    outline: none;
    border-bottom-color: var(--accent);
  }

  .field__input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .field__input.is-invalid { border-bottom-color: #b4452f; }

  .field__textarea { resize: vertical; min-height: 8rem; line-height: 1.7; }

  .field__select-wrap { position: relative; }

  .field__select {
    appearance: none;
    cursor: pointer;
    padding-right: 2rem;
  }

  .field__select:invalid { color: var(--text-on-bone-faint); }

  .field__chevron {
    position: absolute;
    right: 0.35rem;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -6px;
    border-right: 1px solid var(--accent);
    border-bottom: 1px solid var(--accent);
    transform: rotate(45deg);
    pointer-events: none;
  }

  .field__error {
    font-size: 0.78rem;
    color: #b4452f;
    min-height: 1em;
  }

  .field__error:empty { min-height: 0; }

  /* Off-screen rather than display:none — bots that skip hidden
     fields still fill this one. */
  .form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__notice {
    font-size: var(--fs-micro);
    line-height: 1.7;
    color: var(--text-on-bone-faint);
    padding-top: var(--sp-2xs);
  }

  .form__submit { margin-top: var(--sp-2xs); }
  .form__submit:disabled { opacity: 0.6; cursor: wait; }

  .form__status {
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .form__status:empty { display: none; }
  .form__status.is-ok { color: #2f6f4f; }
  .form__status.is-error { color: #b4452f; }
  .form__status a { text-decoration: underline; text-underline-offset: 3px; }

  /* ---- Details ------------------------------------------- */
  .contact__details {
    display: flex;
    flex-direction: column;
    gap: var(--sp-lg);
  }

  .detail-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding-bottom: var(--sp-lg);
    border-bottom: 1px solid var(--rule-on-bone-soft);
  }

  .detail-block__label {
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }

  .detail-block__value {
    font-style: normal;
    line-height: 1.8;
    color: var(--text-on-bone-dim);
  }

  .detail-block__strong {
    font-family: var(--font-sans);
    font-size: 1.02rem;
    letter-spacing: 0.02em;
    color: var(--text-on-bone);
    overflow-wrap: anywhere;
    transition: color var(--dur) var(--ease);
  }

  .detail-block__strong:hover { color: var(--accent); }

  .hours { width: 100%; }

  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-md);
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--rule-on-bone-soft);
    font-size: var(--fs-small);
  }

  .hours__row:last-child { border-bottom: 0; }
  .hours__row dt { color: var(--text-on-bone-dim); }
  .hours__row dd { color: var(--text-on-bone); text-align: right; }

  /* ---- Map ----------------------------------------------- */
  .map {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(155deg, var(--ink-2), var(--obsidian));
    border: 1px solid var(--rule-on-bone);
  }

  .map__trigger {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--text-on-ink);
    transition: background-color var(--dur) var(--ease);
  }

  .map__trigger:hover { background: rgb(198 166 100 / 0.08); }

  .map__pin {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--champagne);
    box-shadow: 0 0 0 6px rgb(198 166 100 / 0.18);
    margin-bottom: 0.5rem;
  }

  .map__label {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .map__note {
    font-size: var(--fs-micro);
    color: var(--text-on-ink-faint);
  }

  .map :global(.map__frame) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
