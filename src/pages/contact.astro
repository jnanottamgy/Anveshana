---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import WhatsAppAction from '../components/WhatsAppAction.astro';
import { firm } from '../data/site';

const description =
  'Contact Anveshana Advocates & Consultants — Crescent Road, Seshadripuram, Bengaluru 560001. Message the chambers on WhatsApp or call +91 99641 40121.';

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${firm.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${firm.url}/contact/` },
    ],
  },
];

/* Aimed at the coordinates rather than the firm's name, so it
   cannot resolve to a different business. Deliberately the bare
   coordinate form: Google also accepts `lat,lng(Label)` to name
   the pin, but that could not be verified from the build
   environment, and an unverifiable flourish is not worth risking
   on the one element whose entire job is to be correct. */
const mapSrc = `https://maps.google.com/maps?q=${firm.geo.lat},${firm.geo.lng}&z=17&output=embed`;

/* What to put in the first message. Enquiries that arrive with
   these four things can be assessed immediately instead of
   turning into three rounds of questions. */
const brief = [
  'What has happened, in a few lines.',
  'When it happened, and whether any date or deadline is already fixed.',
  'Whether any notice, complaint or court paper has been received.',
  'What you would like the outcome to be.',
];
---

<Base title="Contact" description={description} schema={schema} pageType="ContactPage">
  <PageHero
    eyebrow="Contact"
    lines={['Tell us what', 'has <em class="accent-italic">happened.</em>']}
    lead="The first conversation costs you nothing but the time it takes. Message the chambers on WhatsApp, or call directly."
    breadcrumbs={[{ label: 'Contact' }]}
  />

  <section class="contact section on-bone">
    <div class="container contact__grid">
      <!-- ---- The enquiry channel ---- -->
      <div class="reach">
        <h2 class="eyebrow" data-reveal>Message the chambers</h2>

        <p class="reach__lead" data-reveal style="--reveal-delay: 70ms">
          WhatsApp is the fastest way to reach us. Messages are read by the
          advocates themselves, not by an assistant, and are usually answered
          the same working day.
        </p>

        <div class="reach__action" data-reveal style="--reveal-delay: 140ms">
          <WhatsAppAction block />
          <p class="reach__hint">
            Opens WhatsApp on your phone, or WhatsApp Web on a computer.
          </p>
        </div>

        <div class="reach__brief" data-reveal style="--reveal-delay: 210ms">
          <h3 class="reach__brief-label">Worth including in the first message</h3>
          <ol class="brief">
            {brief.map((item, i) => (
              <li class="brief__item">
                <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
                <span>{item}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="reach__alt" data-reveal style="--reveal-delay: 280ms">
          <h3 class="reach__brief-label">Prefer not to use WhatsApp?</h3>
          <p class="reach__alt-copy">
            Call the chambers on
            <a href={`tel:${firm.phoneHref}`}>{firm.phone}</a>, or write to
            <a href={`mailto:${firm.email}`}>{firm.email}</a>.
          </p>
        </div>

        <p class="reach__notice" data-reveal style="--reveal-delay: 340ms">
          Sending a message does not by itself create an advocate–client
          relationship. Please do not send confidential or privileged material
          until we have spoken and confirmed that we are able to act for you.
        </p>
      </div>

      <!-- ---- Details ---- -->
      <aside class="contact__details">
        <div class="detail-block" data-reveal>
          <h2 class="detail-block__label">Chambers</h2>
          <address class="detail-block__value">
            {firm.address.line1}<br />
            {firm.address.line2}<br />
            {firm.address.city} {firm.address.postalCode}
          </address>
          <a class="link-underline" href={firm.mapsDirections} target="_blank" rel="noopener noreferrer">
            Get directions
            <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="detail-block" data-reveal style="--reveal-delay: 80ms">
          <h2 class="detail-block__label">Direct</h2>
          <a class="detail-block__strong" href={`tel:${firm.phoneHref}`}>{firm.phone}</a>
          <a class="detail-block__strong" href={`mailto:${firm.email}`}>{firm.email}</a>
        </div>

        <div class="detail-block" data-reveal style="--reveal-delay: 160ms">
          <h2 class="detail-block__label">Consultation hours</h2>
          <dl class="hours">
            {firm.hours.map((slot) => (
              <div class="hours__row">
                <dt>{slot.days}</dt>
                <dd>{slot.time}</dd>
              </div>
            ))}
          </dl>
        </div>

        <!-- Click-to-load map: no third-party request, and no
             250 KB iframe, until the visitor asks for one. -->
        <div class="map" data-map data-src={mapSrc} data-reveal style="--reveal-delay: 240ms">
          <button class="map__trigger" type="button" data-map-load>
            <span class="map__pin" aria-hidden="true"></span>
            <span class="map__label">Load map</span>
            <span class="map__note">Loads Google Maps in this page</span>
          </button>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  /* ---- Click-to-load map --------------------------------- */
  const map = document.querySelector<HTMLElement>('[data-map]');
  map?.querySelector('[data-map-load]')?.addEventListener('click', () => {
    const frame = document.createElement('iframe');
    frame.src = map.dataset.src || '';
    frame.title = 'Map showing the location of Anveshana Advocates & Consultants';
    frame.loading = 'lazy';
    frame.referrerPolicy = 'no-referrer-when-downgrade';
    frame.className = 'map__frame';
    map.replaceChildren(frame);
  });
</script>

<style>
  .contact { background: var(--bone); color: var(--text-on-bone); }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-2xl);
  }

  @media (min-width: 980px) {
    .contact__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--sp-3xl);
      align-items: start;
    }
  }

  .contact .eyebrow { margin-bottom: var(--sp-md); }

  /* ---- Reach --------------------------------------------- */
  .reach__lead {
    font-size: var(--fs-lead);
    line-height: 1.7;
    font-weight: 300;
    color: var(--text-on-bone-dim);
    max-width: 46ch;
    margin-bottom: var(--sp-lg);
  }

  .reach__action {
    padding-bottom: var(--sp-lg);
    border-bottom: 1px solid var(--rule-on-bone-soft);
  }

  .reach__hint {
    margin-top: 0.75rem;
    font-size: var(--fs-micro);
    letter-spacing: 0.02em;
    color: var(--text-on-bone-faint);
    text-align: center;
  }

  .reach__brief,
  .reach__alt {
    padding-block: var(--sp-lg);
    border-bottom: 1px solid var(--rule-on-bone-soft);
  }

  .reach__brief-label {
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-md);
  }

  .brief {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .brief__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: baseline;
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--text-on-bone-dim);
  }

  .reach__alt-copy {
    font-size: var(--fs-small);
    line-height: 1.8;
    color: var(--text-on-bone-dim);
  }

  .reach__alt-copy a {
    color: var(--text-on-bone);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent);
    overflow-wrap: anywhere;
  }

  .reach__alt-copy a:hover { color: var(--accent); }

  .reach__notice {
    padding-top: var(--sp-lg);
    font-size: var(--fs-micro);
    line-height: 1.75;
    color: var(--text-on-bone-faint);
    max-width: 56ch;
  }

  /* ---- Details ------------------------------------------- */
  .contact__details {
    display: flex;
    flex-direction: column;
    gap: var(--sp-lg);
  }

  .detail-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding-bottom: var(--sp-lg);
    border-bottom: 1px solid var(--rule-on-bone-soft);
  }

  .detail-block__label {
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }

  .detail-block__value {
    font-style: normal;
    line-height: 1.8;
    color: var(--text-on-bone-dim);
  }

  .detail-block__strong {
    font-family: var(--font-sans);
    font-size: 1.02rem;
    letter-spacing: 0.02em;
    color: var(--text-on-bone);
    overflow-wrap: anywhere;
    transition: color var(--dur) var(--ease);
  }

  .detail-block__strong:hover { color: var(--accent); }

  .hours { width: 100%; }

  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-md);
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--rule-on-bone-soft);
    font-size: var(--fs-small);
  }

  .hours__row:last-child { border-bottom: 0; }
  .hours__row dt { color: var(--text-on-bone-dim); }
  .hours__row dd { color: var(--text-on-bone); text-align: right; }

  /* ---- Map ----------------------------------------------- */
  .map {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: linear-gradient(155deg, var(--plate-from), var(--plate-to));
    border: 1px solid var(--plate-rule);
  }

  .map__trigger {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--plate-fg);
    transition: background-color var(--dur) var(--ease);
  }

  .map__trigger:hover { background: var(--tint-accent-soft); }

  .map__pin {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--champagne);
    box-shadow: 0 0 0 6px var(--tint-accent-ring);
    margin-bottom: 0.5rem;
  }

  .map__label {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .map__note {
    font-size: var(--fs-micro);
    color: var(--plate-fg-dim);
  }

  .map :global(.map__frame) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
