---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import Portrait from '../components/Portrait.astro';
import portraits from '../data/portraits.json';
import { firm, people, focusArea, areasLedBy } from '../data/site';

/* The widest rendition that exists for a given portrait. Not a
   fixed 960: a crop is only as wide as its source allows, so the
   largest differs per person, and hard-coding one pointed Google
   at a file that was not there. */
const largest = (slug: string) =>
  (portraits as Record<string, { widths: number[] }>)[slug]?.widths.at(-1);

const description =
  'The advocates of Anveshana Advocates & Consultants, Bengaluru. The advocate you brief at the first consultation is the advocate who argues your matter.';

const schema = [
  ...people.map((person) => ({
    '@type': 'Person',
    '@id': `${firm.url}/people/#${person.slug}`,
    name: `${person.honorific} ${person.name}`,
    jobTitle: person.role,
    worksFor: { '@id': `${firm.url}/#organisation` },
    /* The firm's own wording for what each advocate does, plus
       the URL of each area page they lead.

       As URLs, not as {"@id": ...} references: the Service nodes
       live on their own pages, so an @id reference from here
       points at nothing in this page's graph and dangles.
       knowsAbout accepts a URL, which joins the entities without
       inventing a node. */
    knowsAbout: [
      ...person.focus,
      ...areasLedBy(person.slug).map(
        (a) => `${firm.url}/practice-areas/${a.slug}/`
      ),
    ],
    /* Google shows a portrait against a Person result where one
       is available, and this is the only place it can find it. */
    ...(person.photo && largest(person.slug)
      ? { image: `${firm.url}${person.photo}-${largest(person.slug)}.webp` }
      : {}),
    ...(person.email ? { email: person.email } : {}),
  })),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${firm.url}/` },
      { '@type': 'ListItem', position: 2, name: 'People', item: `${firm.url}/people/` },
    ],
  },
];

---

<Base title="People" description={description} schema={schema} pageType="CollectionPage">
  <PageHero
    eyebrow="People"
    lines={['The advocate', 'you <em class="accent-italic">brief.</em>']}
    lead="No account managers and no handoffs. The person you meet at the first consultation is the person who prepares your matter and appears on it."
    breadcrumbs={[{ label: 'People' }]}
  />

  <section class="people section on-bone">
    <div class="container">
      {people.map((person, i) => (
        <article class="profile" id={person.slug}>
          <div class="profile__plate-wrap" data-reveal="wipe">
            <Portrait person={person} variant="profile" eager={i === 0} />
          </div>

          <div class="profile__body">
            <p class="eyebrow" data-reveal>{person.role}</p>
            <h2 class="profile__name" data-reveal style="--reveal-delay: 70ms">
              <span class="profile__honorific">{person.honorific}</span>
              {person.name}
            </h2>

            <div class="profile__bio prose" data-reveal style="--reveal-delay: 140ms">
              {person.bio.map((para) => <p>{para}</p>)}
            </div>

            <div class="profile__meta" data-reveal style="--reveal-delay: 210ms">
              <div class="profile__meta-block">
                <h3 class="profile__meta-label">Principal areas</h3>
                <ul class="profile__focus">
                  {person.focus.map((label) => {
                    const slug = focusArea[label];
                    return (
                      <li>
                        {slug ? (
                          <a href={`/practice-areas/${slug}/`}>{label}</a>
                        ) : (
                          label
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>

              {person.email && (
                <div class="profile__meta-block">
                  <h3 class="profile__meta-label">Contact</h3>
                  <a class="profile__email" href={`mailto:${person.email}`}>
                    {person.email}
                  </a>
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CTABand
    eyebrow="Speak to us"
    lines={['Ask for the', 'advocate <em class="accent-italic">by name.</em>']}
    body="Tell us briefly what your matter concerns and we will put you in front of the right person at the firm — usually within the same working day."
  />
</Base>

<style>
  .people { background: var(--bone); color: var(--text-on-bone); }

  .profile {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-lg);
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--rule-on-bone-soft);
    /* Anchor links from the homepage teaser must clear the
       fixed header. */
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }

  .profile:first-child { padding-top: 0; }
  .profile:last-child { border-bottom: 0; padding-bottom: 0; }

  @media (min-width: 880px) {
    .profile {
      grid-template-columns: 0.72fr 1.28fr;
      gap: var(--sp-2xl);
      align-items: start;
    }
  }

  /* The plate itself is Portrait.astro — only its placement in
     this layout belongs here.

     NB: deliberately not sticky. Measured, the plate has 46px of
     travel against the biography at 1440px and 300px+ below
     1024px, so a sticky portrait would sit dead still on the
     commonest desktop width and slide a long way on a laptop.
     An effect that only works at some widths reads as a bug at
     the others. */

  .profile__body { padding-top: 0.25rem; }
  .profile .eyebrow { margin-bottom: var(--sp-sm); }

  .profile__name {
    font-size: var(--fs-h2);
    font-weight: 300;
    color: var(--text-on-bone);
    margin-bottom: var(--sp-md);
  }

  .profile__honorific {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-on-bone-faint);
    margin-bottom: 0.45rem;
  }

  .profile__bio p { line-height: 1.78; }

  .profile__meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-md);
    margin-top: var(--sp-lg);
    padding-top: var(--sp-md);
    border-top: 1px solid var(--rule-on-bone-soft);
  }

  @media (min-width: 620px) {
    .profile__meta { grid-template-columns: 1.3fr 1fr; gap: var(--sp-xl); }
  }

  .profile__meta-label {
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.7rem;
  }

  .profile__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
  }

  .profile__focus li {
    font-size: var(--fs-small);
    color: var(--text-on-bone-dim);
  }

  .profile__focus li + li::before {
    content: '·';
    margin-right: 0.9rem;
    color: var(--accent);
  }

  /* The firm's own granular wording stays on the page and becomes
     the link, rather than being replaced by the eight broader
     area names. */
  .profile__focus a {
    text-decoration: underline;
    text-decoration-color: var(--rule-on-bone);
    text-underline-offset: 0.25em;
    transition: color var(--dur) var(--ease),
      text-decoration-color var(--dur) var(--ease);
  }

  .profile__focus a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .profile__email {
    font-size: var(--fs-small);
    color: var(--text-on-bone-dim);
    overflow-wrap: anywhere;
    transition: color var(--dur) var(--ease);
  }

  .profile__email:hover { color: var(--accent); }
</style>
